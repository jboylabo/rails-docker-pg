<% content_for :title, "ログイン" %>
<h1 class="mb-6 text-2xl font-semibold">ログイン</h1>
<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
  <div>
    <%= f.label :email, "メールアドレス", class: "mb-1 block text-sm font-medium" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>
  <div>
    <%= f.label :password, "パスワード", class: "mb-1 block text-sm font-medium" %>
    <%= f.password_field :password, autocomplete: "current-password", required: true, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>
  <% if devise_mapping.rememberable? %>
    <label class="flex items-center gap-2 text-sm">
      <%= f.check_box :remember_me %>
      ログイン状態を保持する
    </label>
  <% end %>
  <%= f.submit "ログイン", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
<% end %>
<p class="mt-6 text-sm">
  <%= link_to "ユーザー登録", new_registration_path(resource_name), class: "underline" %>
  <span class="mx-2 text-stone-300">/</span>
  <%= link_to "パスワードを忘れた場合", new_password_path(resource_name), class: "underline" %>
</p>
