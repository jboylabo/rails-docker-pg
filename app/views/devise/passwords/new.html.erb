<% content_for :title, "パスワード再設定" %>
<h1 class="mb-2 text-2xl font-semibold">パスワード再設定</h1>
<p class="mb-6 text-sm text-stone-600">再設定用のメールは開発環境では送信せず、<code>tmp/mail</code> にファイルとして保存します。</p>
<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <div>
    <%= f.label :email, "メールアドレス", class: "mb-1 block text-sm font-medium" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>
  <%= f.submit "再設定メールを作成する", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
<% end %>
<p class="mt-6 text-sm"><%= link_to "ログインへ", new_session_path(resource_name), class: "underline" %></p>
