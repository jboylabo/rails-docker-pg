<% content_for :title, "タスク一覧" %>

<div class="mb-6 flex items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold">タスク一覧</h1>
  <%= link_to "新規作成", new_task_path, class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
</div>

<% if @tasks.empty? %>
  <p class="rounded-md border border-dashed border-stone-300 bg-white px-4 py-8 text-center text-stone-600">タスクはまだありません。</p>
<% else %>
  <ul class="space-y-3">
    <% @tasks.each do |task| %>
      <li class="rounded-lg border border-stone-200 bg-white p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h2 class="text-lg font-medium">
              <%= link_to task.title, task, class: "underline decoration-stone-300 underline-offset-4" %>
            </h2>
            <p class="mt-1 text-sm text-stone-600"><%= task.description.presence || "説明なし" %></p>
            <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-3">
              <div><dt class="text-stone-500">ステータス</dt><dd><%= task.status_label %></dd></div>
              <div><dt class="text-stone-500">優先度</dt><dd><%= task.priority_label %></dd></div>
              <div><dt class="text-stone-500">期限</dt><dd><%= format_timestamp(task.due_at) %></dd></div>
              <div><dt class="text-stone-500">作成日時</dt><dd><%= format_timestamp(task.created_at) %></dd></div>
            </dl>
          </div>
          <div class="flex gap-2">
            <%= link_to "編集", edit_task_path(task), class: "rounded-md border border-stone-300 px-3 py-1.5 text-sm" %>
            <%= button_to "削除", task, method: :delete, form: { data: { turbo_confirm: "このタスクを削除しますか？" } }, class: "rounded-md border border-rose-200 px-3 py-1.5 text-sm text-rose-700" %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
