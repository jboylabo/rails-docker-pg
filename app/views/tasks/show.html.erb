<% content_for :title, @task.title %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold"><%= @task.title %></h1>
  <div class="flex gap-2">
    <%= link_to "編集", edit_task_path(@task), class: "rounded-md border border-stone-300 px-3 py-1.5 text-sm" %>
    <%= button_to "削除", @task, method: :delete, form: { data: { turbo_confirm: "このタスクを削除しますか？" } }, class: "rounded-md border border-rose-200 px-3 py-1.5 text-sm text-rose-700" %>
  </div>
</div>

<dl class="space-y-4 rounded-lg border border-stone-200 bg-white p-4 text-sm">
  <div>
    <dt class="text-stone-500">説明</dt>
    <dd class="mt-1 whitespace-pre-wrap"><%= @task.description.presence || "説明なし" %></dd>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div><dt class="text-stone-500">ステータス</dt><dd class="mt-1"><%= @task.status_label %></dd></div>
    <div><dt class="text-stone-500">優先度</dt><dd class="mt-1"><%= @task.priority_label %></dd></div>
    <div><dt class="text-stone-500">期限</dt><dd class="mt-1"><%= format_timestamp(@task.due_at) %></dd></div>
    <div><dt class="text-stone-500">完了日時</dt><dd class="mt-1"><%= format_timestamp(@task.completed_at) %></dd></div>
    <div><dt class="text-stone-500">作成日時</dt><dd class="mt-1"><%= format_timestamp(@task.created_at) %></dd></div>
    <div><dt class="text-stone-500">更新日時</dt><dd class="mt-1"><%= format_timestamp(@task.updated_at) %></dd></div>
  </div>
</dl>

<p class="mt-6"><%= link_to "一覧へ戻る", tasks_path, class: "text-sm underline" %></p>
