<%= form_with model: task, class: "space-y-4" do |f| %>
  <% if task.errors.any? %>
    <div class="rounded-md bg-rose-50 px-4 py-3 text-sm text-rose-800">
      <p class="font-medium">入力を確認してください。</p>
      <ul class="mt-2 list-disc pl-5">
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "タスク名", class: "mb-1 block text-sm font-medium" %>
    <%= f.text_field :title, required: true, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>

  <div>
    <%= f.label :description, "説明", class: "mb-1 block text-sm font-medium" %>
    <%= f.text_area :description, rows: 4, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :status, "ステータス", class: "mb-1 block text-sm font-medium" %>
      <%= f.select :status, Task::STATUS_LABELS.map { |key, label| [label, key] }, {}, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>
    <div>
      <%= f.label :priority, "優先度", class: "mb-1 block text-sm font-medium" %>
      <%= f.select :priority, Task::PRIORITY_LABELS.map { |key, label| [label, key] }, {}, class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :due_at, "期限", class: "mb-1 block text-sm font-medium" %>
      <%= f.datetime_field :due_at, value: datetime_local_value(task.due_at), class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>
    <div>
      <%= f.label :completed_at, "完了日時", class: "mb-1 block text-sm font-medium" %>
      <%= f.datetime_field :completed_at, value: datetime_local_value(task.completed_at), class: "w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>
  </div>

  <div class="flex gap-3">
    <%= f.submit task.persisted? ? "更新する" : "作成する", class: "rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    <%= link_to "キャンセル", task.persisted? ? task_path(task) : tasks_path, class: "px-4 py-2 text-sm underline" %>
  </div>
<% end %>
